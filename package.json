{
  "name": "p2p-transfer",
  "version": "1.0.0",
  "private": true,
  "description": "局域网文件与文本传输平台（Next.js 16 + WebRTC 局域网直连，无服务器、纯静态导出）",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node -e \"require('fs').copyFileSync('public/404.html', 'out/404.html')\"",
    "preview": "serve out",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "serve": "^14.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
